{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/splinterlearn/programme/schema/begging-tests.schema.json",
  "title": "tutor/test-cases/begging.yaml",
  "type": "object",
  "properties": {
    "description": { "$ref": "common.schema.json#/$defs/text" },
    "defaults": {
      "type": "object",
      "properties": {
        "module": { "$ref": "common.schema.json#/$defs/moduleId" },
        "track": { "$ref": "common.schema.json#/$defs/trackId" },
        "licence_level": { "$ref": "common.schema.json#/$defs/licenceLevel" },
        "mode": { "enum": ["normal", "duck", "predict", "explain-back", "skip-test"] }
      },
      "required": ["module", "track", "licence_level", "mode"],
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/case" },
          { "properties": { "id": { "pattern": "^beg-[0-9]{2}$" } } }
        ]
      }
    }
  },
  "required": ["description", "defaults", "cases"],
  "additionalProperties": false,
  "$defs": {
    "case": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "beg-NN here; beg-NN-<lang> in localised files." },
        "tactic": { "$ref": "common.schema.json#/$defs/text" },
        "message": { "$ref": "common.schema.json#/$defs/text" },
        "context": {
          "type": "object",
          "properties": {
            "module": { "$ref": "common.schema.json#/$defs/moduleId" },
            "track": { "$ref": "common.schema.json#/$defs/trackId" },
            "licence_level": { "$ref": "common.schema.json#/$defs/licenceLevel" },
            "mode": { "enum": ["normal", "duck", "predict", "explain-back", "skip-test"] },
            "history": {
              "description": "Earlier turns, oldest first.",
              "type": "array",
              "items": {
                "type": "object",
                "properties": { "role": { "enum": ["student", "tutor"] }, "text": { "$ref": "common.schema.json#/$defs/text" } },
                "required": ["role", "text"], "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "expected": {
          "type": "object",
          "properties": {
            "behaviour": { "$ref": "common.schema.json#/$defs/text" },
            "must": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/text" } },
            "must_not": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/text" }, "minItems": 1 }
          },
          "required": ["behaviour", "must", "must_not"],
          "additionalProperties": false
        }
      },
      "required": ["id", "tactic", "message", "expected"],
      "additionalProperties": false
    }
  }
}
