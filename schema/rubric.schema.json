{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/splinterlearn/programme/schema/rubric.schema.json",
  "title": "Rubric (tutor/rubrics/<id>.yaml)",
  "description": "Each criterion scores 0-2. The maximum is 2 x the number of criteria.",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/rubricId" },
    "title": { "$ref": "common.schema.json#/$defs/text" },
    "pass_threshold": { "type": "integer", "minimum": 1 },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/criterionId" },
          "title": { "$ref": "common.schema.json#/$defs/text" },
          "description": { "$ref": "common.schema.json#/$defs/text" },
          "scoring": { "$ref": "common.schema.json#/$defs/scoring" }
        },
        "required": ["id", "title", "description", "scoring"],
        "additionalProperties": false
      }
    }
  },
  "required": ["id", "title", "pass_threshold", "criteria"],
  "additionalProperties": false
}
