{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/splinterlearn/programme/schema/llm-output/explain-back-result.schema.json",
  "title": "Explain-back session result",
  "description": "Computed by the bot from the per-answer grades (not generated by the LLM). Stored, stamped with the content SHA, and summarised in the PR status and the digest.",
  "type": "object",
  "properties": {
    "scope": { "type": "string", "pattern": "^(m[0-9]\\.[0-9]+|b[0-9]\\.skip)$" },
    "mode": { "enum": ["module", "skip-test"] },
    "content_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "question_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "competencies_covered": { "type": "array", "items": { "type": "string" } },
    "scores": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 2 } },
    "total": { "type": "integer", "minimum": 0 },
    "max": { "type": "integer", "minimum": 1 },
    "percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "micro_task_correct": { "type": "boolean" },
    "time_box_minutes": { "anyOf": [ { "type": "integer" }, { "type": "null" } ] },
    "pass": { "type": "boolean" },
    "retry_after": { "anyOf": [ { "type": "string", "format": "date-time" }, { "type": "null" } ] }
  },
  "required": ["scope", "mode", "content_sha", "question_ids", "competencies_covered", "scores", "total", "max", "percent", "micro_task_correct", "time_box_minutes", "pass", "retry_after"],
  "additionalProperties": false
}
