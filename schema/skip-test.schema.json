{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/splinterlearn/programme/schema/skip-test.schema.json",
  "title": "skip-test.md frontmatter",
  "description": "A block skip test: either all module exit gates (module-gates) or a set of tasks with its own bank (tasks).",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/skipTestId" },
    "block": { "$ref": "common.schema.json#/$defs/blockId" },
    "status": { "$ref": "common.schema.json#/$defs/status" },
    "kind": { "enum": ["module-gates", "tasks"] },
    "ai": { "const": "off" }
  },
  "required": ["id", "block", "status", "kind", "ai"],
  "oneOf": [
    {
      "properties": {
        "id": true, "block": true, "status": true, "ai": true,
        "kind": { "const": "module-gates" },
        "modules": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/moduleId" }, "minItems": 1, "uniqueItems": true },
        "time_box_minutes_per_module": { "type": "integer", "minimum": 10, "maximum": 180 },
        "explain_back": {
          "type": "object",
          "properties": {
            "sample_per_module": { "type": "integer", "minimum": 1, "maximum": 7 },
            "micro_task_per_module": { "type": "integer", "minimum": 1, "maximum": 2 }
          },
          "required": ["sample_per_module", "micro_task_per_module"],
          "additionalProperties": false
        }
      },
      "required": ["modules", "time_box_minutes_per_module", "explain_back"],
      "additionalProperties": false
    },
    {
      "properties": {
        "id": true, "block": true, "status": true, "ai": true,
        "kind": { "const": "tasks" },
        "time_box_minutes": { "type": "integer", "minimum": 10, "maximum": 180 },
        "competencies": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/competency" }, "minItems": 1 },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/taskId" },
              "title": { "$ref": "common.schema.json#/$defs/text" },
              "check": { "$ref": "common.schema.json#/$defs/text" }
            },
            "required": ["id", "title", "check"],
            "additionalProperties": false
          }
        },
        "explain_back": {
          "type": "object",
          "properties": {
            "file": { "type": "string", "pattern": "^[a-z0-9.-]+\\.yaml$" },
            "sample": { "type": "integer", "minimum": 1, "maximum": 7 },
            "micro_tasks": { "type": "integer", "minimum": 1, "maximum": 2 }
          },
          "required": ["file", "sample", "micro_tasks"],
          "additionalProperties": false
        },
        "coverage": { "$ref": "common.schema.json#/$defs/coverage" }
      },
      "required": ["time_box_minutes", "competencies", "tasks", "explain_back", "coverage"],
      "additionalProperties": false
    }
  ]
}
