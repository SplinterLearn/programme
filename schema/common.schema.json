{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/splinterlearn/programme/schema/common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "blockId": { "type": "string", "pattern": "^b[0-9]$" },
    "moduleId": { "type": "string", "pattern": "^m[0-9]\\.[0-9]+$" },
    "ownerId": {
      "description": "A module id (m2.1) or a skip-test owner (b3.skip).",
      "type": "string", "pattern": "^(m[0-9]\\.[0-9]+|b[0-9]\\.skip)$"
    },
    "skipTestId": { "type": "string", "pattern": "^b[0-9]-skip$" },
    "competencyId": { "type": "string", "pattern": "^(m[0-9]\\.[0-9]+|b[0-9]\\.skip)\\.c[0-9]+$" },
    "questionId": { "type": "string", "pattern": "^(m[0-9]\\.[0-9]+|b[0-9]\\.skip)\\.q[0-9]+$" },
    "checkId": { "type": "string", "pattern": "^m[0-9]\\.[0-9]+\\.k[0-9]+$" },
    "taskId": { "type": "string", "pattern": "^b[0-9]\\.skip\\.t[0-9]+$" },
    "trackId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "rubricId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "criterionId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "status": { "enum": ["ready", "draft", "stub"] },
    "licenceLevel": { "enum": ["L0", "L1", "L2", "L3"] },
    "text": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "pattern": "^https?://\\S+$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "weeks": {
      "description": "Inclusive [first, last] programme week (1-40).",
      "type": "array", "prefixItems": [
        { "type": "integer", "minimum": 1, "maximum": 40 },
        { "type": "integer", "minimum": 1, "maximum": 40 }
      ], "minItems": 2, "maxItems": 2
    },
    "scoring": {
      "description": "Anchors for scores 0, 1 and 2. Keys are quoted strings in YAML.",
      "type": "object",
      "properties": { "0": { "$ref": "#/$defs/text" }, "1": { "$ref": "#/$defs/text" }, "2": { "$ref": "#/$defs/text" } },
      "required": ["0", "1", "2"],
      "additionalProperties": false
    },
    "gateRef": {
      "description": "A gate item: test:<pytest function>, eb:<question id>, rubric:<criterion id>, check:<check id>, task:<skip-test task id>.",
      "type": "string",
      "pattern": "^(test:[A-Za-z_][A-Za-z0-9_]*|eb:(m[0-9]\\.[0-9]+|b[0-9]\\.skip)\\.q[0-9]+|rubric:[a-z][a-z0-9_]*|check:m[0-9]\\.[0-9]+\\.k[0-9]+|task:b[0-9]\\.skip\\.t[0-9]+)$"
    },
    "competency": {
      "type": "object",
      "properties": { "id": { "$ref": "#/$defs/competencyId" }, "text": { "$ref": "#/$defs/text" } },
      "required": ["id", "text"],
      "additionalProperties": false
    },
    "coverage": {
      "description": "Competency id -> list of gate items that check it.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/competencyId" },
      "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/gateRef" }, "minItems": 1, "uniqueItems": true }
    },
    "link": {
      "type": "object",
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "url": { "$ref": "#/$defs/url" },
        "notes": { "type": "string" },
        "verified_on": { "$ref": "#/$defs/date" }
      },
      "required": ["title", "url"],
      "additionalProperties": false
    }
  }
}
